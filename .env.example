# Mail Mind (.env template)
#
# Copy to `backend/.env` for backend config.
# (We keep this template at the repo root for visibility.)

# --- Core ---
# Use an absolute path to avoid ambiguity when launching from different directories.
# Example: sqlite:////Users/yourname/src/mail-mind/backend/mailmind.db
MAILMIND_DATABASE_URL=sqlite:///./mailmind.db
MAILMIND_FRONTEND_URL=http://localhost:3000

# --- Provider integrations (upcoming) ---
# Gmail OAuth
MAILMIND_GMAIL_CLIENT_ID=
MAILMIND_GMAIL_CLIENT_SECRET=
MAILMIND_GMAIL_REDIRECT_URI=http://localhost:8000/api/oauth/gmail/callback

# Encrypt provider tokens at rest (required once OAuth is enabled).
# For now leave blank; when implemented we’ll document the expected format.
MAILMIND_TOKEN_ENCRYPTION_KEY=

# --- Optional AI classification (label suggestions) ---
# Supported providers: gemini, openai
# Gemini 2.0 Flash is free (1,500 requests/day) — no credit card required.
MAILMIND_AI_PROVIDER=
MAILMIND_AI_API_KEY=

